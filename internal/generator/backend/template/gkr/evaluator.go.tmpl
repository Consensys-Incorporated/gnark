{{ define "gateEvaluator" }}
{{- $elem := .Config.BaseElementType }}
{{- $poly := .Config.BasePolynomial }}
{{- $suffix := "" }}
{{- $ge := "GateEvaluator" }}
{{- if .Mixed }}
