{{ define "gateEvaluator" }}
{{- $elem := .Config.BaseElementType }}
{{- $poly := .Config.BasePolynomial }}
{{- $suffix := "" }}
{{- $ge := "GateEvaluator" }}
{{- if .Mixed }}
{{- $elem = .Config.ElementType }}
{{- $poly = "polynomial" }}
{{- $suffix = .Config.ExtensionSuffix }}
{{- $ge = "GateEvaluatorMixed" }}
{{- end }}
// {{ $ge }} provides a high-level API for evaluating compiled gates efficiently.
// It manages the registers and constants internally and handles input buffering, making it easy to
// evaluate the same gate multiple times with different inputs.
type {{ $ge }} struct {
	gate gkr.GateBytecode
	vars []{{ $elem }} // the registers, then the constants
	{{- if .Mixed }}
	consts []{{ .Config.BaseElementType }} // the gate's constants in the base field, for the extension's methods taking a base field element
	{{- end }}
	nbRegisters int // number of registers, which the constants follow in vars
	nbPushed int // number of inputs pushed since the last evaluation
	pool *{{ $poly }}.Pool{{ $suffix }} // pool vars was allocated from, if any
}

// New{{ $ge }} creates an evaluator for the given compiled gate.
// The constants are preloaded and the evaluator is ready for evaluation. It panics if the gate's
// CheckConstantPositions returns an error.
func New{{ $ge }}(gate gkr.GateBytecode, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) {{ $ge }} {
	if err := gate.CheckConstantPositions(); err != nil {
		panic(err)
	}
	e := {{ $ge }}{
		gate:        gate,
		nbRegisters: gate.NbRegisters(),
	}
	if len(elementPool) > 0 {
		e.pool = elementPool[0]
		e.vars = e.pool.Make(gate.EvaluatorSize())
	} else {
		e.vars = make([]{{ $elem }}, gate.EvaluatorSize())
	}
	for i, constVal := range gate.Constants {
		e.vars[e.nbRegisters+i].SetBigInt(constVal)
	}
	{{- if .Mixed }}
	e.consts = make([]{{ .Config.BaseElementType }}, len(gate.Constants))
	for i, constVal := range gate.Constants {
		e.consts[i].SetBigInt(constVal)
	}
	{{- end }}
	return e
}

// Dump returns the evaluator's memory to the pool it was allocated from, if any, and does
// nothing otherwise. The evaluator must not be used after this.
func (e *{{ $ge }}) Dump() {
	if e.pool != nil {
		e.pool.Dump(e.vars)
	}
}

// PushInput adds an input to the evaluator's input buffer, the first registers.
// Inputs must be added in order, and the number of inputs must match the gate's NbIn.
func (e *{{ $ge }}) PushInput(input {{ $elem }}) {
	if e.nbPushed == e.gate.NbIn {
		panic(fmt.Sprintf("expected %d inputs, got more", e.gate.NbIn))
	}
	e.vars[e.nbPushed] = input
	e.nbPushed++
}

{{ if .Mixed -}}
// isInputConstant returns whether the instruction's inputI-th input is one of the gate's constants.
func (e *{{ $ge }}) isInputConstant(inst *gkr.GateInstruction, inputI int) bool {
	return int(inst.Inputs[inputI]) >= e.nbRegisters
}

// constant returns the instruction's first input, a constant, in the base field.
func (e *{{ $ge }}) constant(inst *gkr.GateInstruction) *{{ .Config.BaseElementType }} {
	return &e.consts[int(inst.Inputs[0])-e.nbRegisters]
}

{{ end -}}
// Evaluate adds top to the inputs in the first registers, executes the gate on them and returns the
// result. The inputs are automatically cleared after evaluation,
// making the evaluator ready for the next evaluation.
// NB! The result is short-lived. It will be overwritten the next time Evaluate is called.
func (e *{{ $ge }}) Evaluate(top ...{{ $elem }}) *{{ $elem }} {
	if e.nbPushed+len(top) != e.gate.NbIn {
		panic(fmt.Sprintf("expected %d inputs, got %d", e.gate.NbIn, e.nbPushed+len(top)))
	}
	copy(e.vars[e.nbPushed:], top)

	// Execute instructions, each writing its result to its register
	// The registers after the inputs are written before they are read
	for i := range e.gate.Instructions {
		inst := &e.gate.Instructions[i]
		dst := &e.vars[inst.Dst]

		// Use switch instead of function pointer for better inlining
		switch inst.Op {
		case gkr.OpAdd:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.AddElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				dst.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Add(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpMul:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.MulByElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				dst.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Mul(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpSub:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.SubFromElement(e.constant(inst), &e.vars[inst.Inputs[1]])
			} else {
				dst.Sub(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Sub(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Sub(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpNeg:
			dst.Neg(&e.vars[inst.Inputs[0]])
		case gkr.OpMulAcc:
			var prod {{ $elem }}
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				prod.MulByElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				prod.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			prod.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			dst.Add(&prod, &e.vars[inst.Inputs[2]])
		case gkr.OpSumExp17:
			// result = (x[0] + x[1] + x[2])¹⁷
			var sum {{ $elem }}
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				sum.AddElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				sum.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			sum.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			sum.Add(&sum, &e.vars[inst.Inputs[2]])
			dst.Mul(&sum, &sum) // x²
			dst.Mul(dst, dst)   // x⁴
			dst.Mul(dst, dst)   // x⁸
			dst.Mul(dst, dst)   // x¹⁶
			dst.Mul(dst, &sum)  // x¹⁷
		default:
			panic(fmt.Sprintf("unknown operation: %d", inst.Op))
		}
	}

	res := &e.vars[e.gate.ResultRegister()]

	// Reset for next evaluation
	e.nbPushed = 0

	return res
}

// {{ $ge }}Pool manages a pool of gate evaluators for a specific gate type.
// The evaluators allocate their element slices from the polynomial.Pool the pool was given, if any.
type {{ $ge }}Pool struct {
	gate        gkr.GateBytecode
	lock        sync.Mutex
	available   []*{{ $ge }}
	elementPool []*{{ $poly }}.Pool{{ $suffix }}
}

func New{{ $ge }}Pool(gate gkr.GateBytecode, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) *{{ $ge }}Pool {
	return &{{ $ge }}Pool{
		gate:        gate,
		elementPool: elementPool,
	}
}

func (gep *{{ $ge }}Pool) Get() *{{ $ge }} {
	gep.lock.Lock()
	if n := len(gep.available); n > 0 {
		e := gep.available[n-1]
		gep.available = gep.available[:n-1]
		gep.lock.Unlock()
		return e
	}
	gep.lock.Unlock()

	e := New{{ $ge }}(gep.gate, gep.elementPool...)
	return &e
}

func (gep *{{ $ge }}Pool) Put(e *{{ $ge }}) {
	gep.lock.Lock()
	gep.available = append(gep.available, e)
	gep.lock.Unlock()
}

// DumpAll dumps all available evaluators' memory back to the pool. It is not to be used after that.
// NB! User must ensure all evaluators have been put back in the pool to prevent memory leaks.
func (gep *{{ $ge }}Pool) DumpAll() {
	gep.lock.Lock()
	defer gep.lock.Unlock()
	for _, e := range gep.available {
		e.Dump()
	}
	gep.available = nil
}
{{ end }}
