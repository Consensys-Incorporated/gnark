{{ define "gateEvaluator" }}
{{- $elem := .Config.BaseElementType }}
{{- $poly := .Config.BasePolynomial }}
{{- $suffix := "" }}
{{- $ge := "GateEvaluator" }}
{{- if .Mixed }}
{{- $elem = .Config.ElementType }}
{{- $poly = "polynomial" }}
{{- $suffix = .Config.ExtensionSuffix }}
{{- $ge = "GateEvaluatorMixed" }}
{{- end }}
// {{ $ge }} provides a high-level API for evaluating compiled gates efficiently.
// It manages the registers and constants internally and handles input buffering, making it easy to
// evaluate the same gate multiple times with different inputs.
type {{ $ge }} struct {
	gate gkr.GateBytecode
	vars []{{ $elem }} // the registers, then the constants
	{{- if .Mixed }}
	consts []{{ .Config.BaseElementType }} // the gate's constants in the base field, for the extension's methods taking a base field element
	{{- end }}
	nbRegisters int // number of registers, which the constants follow in vars
	nbPushed int // number of inputs pushed since the last evaluation
	pool *{{ $poly }}.Pool{{ $suffix }} // pool vars was allocated from, if any
}

// New{{ $ge }} creates an evaluator for the given compiled gate.
// The constants are preloaded and the evaluator is ready for evaluation. It panics if the gate's
// CheckEvaluatorAssumptions returns an error.
func New{{ $ge }}(gate gkr.GateBytecode, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) {{ $ge }} {
	if err := gate.CheckEvaluatorAssumptions(); err != nil {
		panic(err)
	}
	e := {{ $ge }}{
		gate:        gate,
		nbRegisters: gate.NbRegisters(),
	}
	if len(elementPool) > 0 {
		e.pool = elementPool[0]
		e.vars = e.pool.Make(gate.EvaluatorSize())
	} else {
		e.vars = make([]{{ $elem }}, gate.EvaluatorSize())
	}
	for i, constVal := range gate.Constants {
		e.vars[e.nbRegisters+i].SetBigInt(constVal)
	}
	{{- if .Mixed }}
	e.consts = make([]{{ .Config.BaseElementType }}, len(gate.Constants))
	for i, constVal := range gate.Constants {
		e.consts[i].SetBigInt(constVal)
	}
	{{- end }}
	return e
}

// Dump returns the evaluator's memory to the pool it was allocated from, if any, and does
// nothing otherwise. The evaluator must not be used after this.
func (e *{{ $ge }}) Dump() {
	if e.pool != nil {
		e.pool.Dump(e.vars)
	}
}

// PushInput adds an input to the evaluator's input buffer, the first registers.
// Inputs must be added in order, and the number of inputs must match the gate's NbIn.
func (e *{{ $ge }}) PushInput(input {{ $elem }}) {
	if e.nbPushed == e.gate.NbIn {
		panic(fmt.Sprintf("expected %d inputs, got more", e.gate.NbIn))
	}
	e.vars[e.nbPushed] = input
	e.nbPushed++
}

{{ if .Mixed -}}
// isInputConstant returns whether the instruction's inputI-th input is one of the gate's constants.
func (e *{{ $ge }}) isInputConstant(inst *gkr.GateInstruction, inputI int) bool {
	return int(inst.Inputs[inputI]) >= e.nbRegisters
}

// constant returns the instruction's first input, a constant, in the base field.
func (e *{{ $ge }}) constant(inst *gkr.GateInstruction) *{{ .Config.BaseElementType }} {
	return &e.consts[int(inst.Inputs[0])-e.nbRegisters]
}

{{ end -}}
// Evaluate adds top to the inputs in the first registers, executes the gate on them and returns the
// result. The inputs are automatically cleared after evaluation,
// making the evaluator ready for the next evaluation.
// NB! The result is short-lived. It will be overwritten the next time Evaluate is called.
func (e *{{ $ge }}) Evaluate(top ...{{ $elem }}) *{{ $elem }} {
	if e.nbPushed+len(top) != e.gate.NbIn {
		panic(fmt.Sprintf("expected %d inputs, got %d", e.gate.NbIn, e.nbPushed+len(top)))
	}
	copy(e.vars[e.nbPushed:], top)

	// Execute instructions, each writing its result to its register
	// The registers after the inputs are written before they are read
	for i := range e.gate.Instructions {
		inst := &e.gate.Instructions[i]
		dst := &e.vars[inst.Dst]

		// Use switch instead of function pointer for better inlining
		switch inst.Op {
		case gkr.OpAdd:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.AddElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				dst.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Add(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpMul:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.MulByElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				dst.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Mul(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpSub:
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				dst.SubFromElement(e.constant(inst), &e.vars[inst.Inputs[1]])
			} else {
				dst.Sub(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			dst.Sub(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Sub(dst, &e.vars[inst.Inputs[j]])
			}
		case gkr.OpNeg:
			dst.Neg(&e.vars[inst.Inputs[0]])
		case gkr.OpMulAcc:
			var prod {{ $elem }}
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				prod.MulByElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				prod.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			prod.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			dst.Add(&prod, &e.vars[inst.Inputs[2]])
		case gkr.OpSumExp17:
			// result = (x[0] + x[1] + x[2])¹⁷
			var sum {{ $elem }}
			{{- if .Mixed }}
			if e.isInputConstant(inst, 0) {
				sum.AddElement(&e.vars[inst.Inputs[1]], e.constant(inst))
			} else {
				sum.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			}
			{{- else }}
			sum.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			{{- end }}
			sum.Add(&sum, &e.vars[inst.Inputs[2]])
			dst.Mul(&sum, &sum) // x²
			dst.Mul(dst, dst)   // x⁴
			dst.Mul(dst, dst)   // x⁸
			dst.Mul(dst, dst)   // x¹⁶
			dst.Mul(dst, &sum)  // x¹⁷
		default:
			panic(fmt.Sprintf("unknown operation: %d", inst.Op))
		}
	}

	res := &e.vars[e.gate.ResultRegister()]

	// Reset for next evaluation
	e.nbPushed = 0

	return res
}

// {{ $ge }}Pool manages a pool of gate evaluators for a specific gate type.
// The evaluators allocate their element slices from the polynomial.Pool the pool was given, if any.
type {{ $ge }}Pool struct {
	gate        gkr.GateBytecode
	lock        sync.Mutex
	available   []*{{ $ge }}
	elementPool []*{{ $poly }}.Pool{{ $suffix }}
}

func New{{ $ge }}Pool(gate gkr.GateBytecode, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) *{{ $ge }}Pool {
	return &{{ $ge }}Pool{
		gate:        gate,
		elementPool: elementPool,
	}
}

func (gep *{{ $ge }}Pool) Get() *{{ $ge }} {
	gep.lock.Lock()
	if n := len(gep.available); n > 0 {
		e := gep.available[n-1]
		gep.available = gep.available[:n-1]
		gep.lock.Unlock()
		return e
	}
	gep.lock.Unlock()

	e := New{{ $ge }}(gep.gate, gep.elementPool...)
	return &e
}

func (gep *{{ $ge }}Pool) Put(e *{{ $ge }}) {
	gep.lock.Lock()
	gep.available = append(gep.available, e)
	gep.lock.Unlock()
}

// DumpAll dumps all available evaluators' memory back to the pool. It is not to be used after that.
// NB! User must ensure all evaluators have been put back in the pool to prevent memory leaks.
func (gep *{{ $ge }}Pool) DumpAll() {
	gep.lock.Lock()
	defer gep.lock.Unlock()
	for _, e := range gep.available {
		e.Dump()
	}
	gep.available = nil
}
{{ end }}

{{ define "gateBlockEvaluator" }}
{{- $base := .Config.BaseElementType }}
{{- $elem := $base }}
{{- $vec := printf "%s.Vector" .Config.BaseFieldPackageName }}
{{- $poly := .Config.BasePolynomial }}
{{- $suffix := "" }}
{{- $ge := "GateBlockEvaluator" }}
{{- $scalarMul := "ScalarMul" }}
{{- $el := "" }}
{{- if .Mixed }}
{{- $elem = .Config.ElementType }}
{{- $vec = printf "%s.Vector%s" .Config.FieldPackageName .Config.ExtensionSuffix }}
{{- $poly = "polynomial" }}
{{- $suffix = .Config.ExtensionSuffix }}
{{- $ge = "GateBlockEvaluatorMixed" }}
{{- $scalarMul = "ScalarMulByElement" }}
{{- $el = "Element" }}
{{- end }}
// {{ $ge }} evaluates a compiled gate over blocks of instances: each instruction is a sequence of
// vector method calls over a block. Its registers are slices of at most the block size. The first NbIn are the
// slices that the caller passes to Evaluate, which the gate may overwrite; the evaluator owns the others.
// The constants are scalars, never registers: a constant operand feeds the scalar form of its operation.
type {{ $ge }} struct {
	gate   gkr.GateBytecode
	regs   []{{ $vec }}
	tmp    {{ $vec }} // the scratch of SumExp17, if the gate has one
	consts []{{ $base }}
	pool   *{{ $poly }}.Pool{{ $suffix }} // pool the owned registers were allocated from, if any
}

// New{{ $ge }} creates a block evaluator for the given compiled gate, for blocks of up to blockSize
// instances. It allocates the registers that it owns, from the element pool if it is given one. It
// panics if the gate has no inputs, as a gate compiled before registers existed does, or if a constant
// operand is not where the evaluators read it first.
func New{{ $ge }}(gate gkr.GateBytecode, blockSize int, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) {{ $ge }} {
	if gate.NbIn == 0 {
		panic("the gate has no inputs: it was compiled by an older gnark")
	}
	if err := gate.CheckEvaluatorAssumptions(); err != nil {
		panic(err)
	}
	e := {{ $ge }}{
		gate:   gate,
		regs:   make([]{{ $vec }}, gate.NbRegisters()),
		consts: make([]{{ $base }}, len(gate.Constants)),
	}
	if len(elementPool) > 0 {
		e.pool = elementPool[0]
	}
	allocate := func() {{ $vec }} {
		if e.pool != nil {
			return e.pool.Make(blockSize)
		}
		return make({{ $vec }}, blockSize)
	}
	for r := gate.NbIn; r < len(e.regs); r++ {
		e.regs[r] = allocate()
	}
	for _, inst := range gate.Instructions {
		if inst.Op == gkr.OpSumExp17 {
			e.tmp = allocate()
			break
		}
	}
	for i, constVal := range gate.Constants {
		e.consts[i].SetBigInt(constVal)
	}
	return e
}

// Dump returns the registers that the evaluator owns to the pool they were allocated from, if any,
// and does nothing otherwise. The evaluator must not be used after this.
func (e *{{ $ge }}) Dump() {
	if e.pool == nil {
		return
	}
	for _, r := range e.regs[e.gate.NbIn:] {
		e.pool.Dump(r[:cap(r)])
	}
	if e.tmp != nil {
		e.pool.Dump(e.tmp[:cap(e.tmp)])
	}
}

// n is the number of instances that Evaluate runs on.
func (e *{{ $ge }}) n() int {
	return len(e.regs[0])
}

// Evaluate executes the gate on the inputs, one slice for each of the gate's inputs, all of the same
// length, at most the block size, which must not overlap, and returns the result, which has that
// length. The gate may overwrite the inputs.
// NB! The result is short-lived. It is an input or a register of the evaluator, which the next call
// may overwrite.
func (e *{{ $ge }}) Evaluate(inputs []{{ $vec }}) {{ $vec }} {
	if len(inputs) != e.gate.NbIn {
		panic(fmt.Sprintf("expected %d inputs, got %d", e.gate.NbIn, len(inputs)))
	}
	copy(e.regs, inputs)
	n := e.n()
	for i, input := range inputs {
		if len(input) != n {
			panic(fmt.Sprintf("input %d has %d entries, input 0 has %d", i, len(input), n))
		}
	}
	for r := e.gate.NbIn; r < len(e.regs); r++ {
		e.regs[r] = e.regs[r][:n]
	}
	if e.tmp != nil {
		e.tmp = e.tmp[:n]
	}

	for i := range e.gate.Instructions {
		inst := &e.gate.Instructions[i]
		dst := e.regs[inst.Dst]

		switch inst.Op {
		case gkr.OpAdd:
			e.add2(dst, inst.Inputs[0], inst.Inputs[1])
			for _, in := range inst.Inputs[2:] {
				dst.Add(dst, e.operand(in))
			}
		case gkr.OpMul:
			e.mul2(dst, inst.Inputs[0], inst.Inputs[1])
			for _, in := range inst.Inputs[2:] {
				dst.Mul(dst, e.operand(in))
			}
		case gkr.OpSub:
			e.sub2(dst, inst.Inputs[0], inst.Inputs[1])
			for _, in := range inst.Inputs[2:] {
				dst.Sub(dst, e.operand(in))
			}
		case gkr.OpNeg:
			dst.Neg(e.operand(inst.Inputs[0]))
		case gkr.OpMulAcc:
			// result = x[0] * x[1] + x[2]
			e.mul2(dst, inst.Inputs[0], inst.Inputs[1])
			e.addTo(dst, inst.Inputs[2])
		case gkr.OpSumExp17:
			// result = (x[0] + x[1] + x[2])^17
			e.add2(dst, inst.Inputs[0], inst.Inputs[1])
			e.addTo(dst, inst.Inputs[2])
			e.tmp.Mul(dst, dst)       // x²
			e.tmp.Mul(e.tmp, e.tmp)   // x⁴
			e.tmp.Mul(e.tmp, e.tmp)   // x⁸
			e.tmp.Mul(e.tmp, e.tmp)   // x¹⁶
			dst.Mul(e.tmp, dst)       // x¹⁷
		default:
			panic(fmt.Sprintf("unknown operation: %d", inst.Op))
		}
	}

	res := e.regs[e.gate.ResultRegister()]
	clear(e.regs[:e.gate.NbIn])
	return res
}

// isConstant returns whether the operand index names a constant.
func (e *{{ $ge }}) isConstant(index uint16) bool {
	return int(index) >= len(e.regs)
}

// operand returns the register that the operand index names.
func (e *{{ $ge }}) operand(index uint16) {{ $vec }} {
	return e.regs[index]
}

// constant returns the constant that the operand index names.
func (e *{{ $ge }}) constant(index uint16) *{{ $base }} {
	return &e.consts[int(index)-len(e.regs)]
}

// addTo adds the operand in to dst.
func (e *{{ $ge }}) addTo(dst {{ $vec }}, in uint16) {
	if e.isConstant(in) {
		dst.ScalarAdd{{ $el }}(dst, e.constant(in))
	} else {
		dst.Add(dst, e.operand(in))
	}
}

// add2 sets dst to the sum of the operands in0 and in1, of which in1 is a register.
func (e *{{ $ge }}) add2(dst {{ $vec }}, in0, in1 uint16) {
	if e.isConstant(in0) {
		dst.ScalarAdd{{ $el }}(e.operand(in1), e.constant(in0))
	} else {
		dst.Add(e.operand(in0), e.operand(in1))
	}
}

// mul2 sets dst to the product of the operands in0 and in1, of which in1 is a register.
func (e *{{ $ge }}) mul2(dst {{ $vec }}, in0, in1 uint16) {
	if e.isConstant(in0) {
		dst.{{ $scalarMul }}(e.operand(in1), e.constant(in0))
	} else {
		dst.Mul(e.operand(in0), e.operand(in1))
	}
}

// sub2 sets dst to the operand in0 minus the operand in1, of which at most one is a constant.
func (e *{{ $ge }}) sub2(dst {{ $vec }}, in0, in1 uint16) {
	switch {
	case e.isConstant(in0):
		dst.ScalarSubFrom{{ $el }}(e.constant(in0), e.operand(in1))
	case e.isConstant(in1):
		dst.ScalarSub{{ $el }}(e.operand(in0), e.constant(in1))
	default:
		dst.Sub(e.operand(in0), e.operand(in1))
	}
}
{{ end }}
