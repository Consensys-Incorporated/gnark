// {{ $ge }} provides a high-level API for evaluating compiled gates efficiently.
// It manages the stack internally and handles input buffering, making it easy to
// evaluate the same gate multiple times with different inputs.
type {{ $ge }} struct {
	gate gkrcore.GateBytecode
	vars []{{ $elem }}
	{{- if .Mixed }}
	consts []{{ .Config.BaseElementType }} // the gate's constants in the base field, multiplied by with MulByElement
	{{- end }}
	nbIn int // number of inputs expected
	pool *{{ $poly }}.Pool{{ $suffix }} // pool vars was allocated from, if any
}

// New{{ $ge }} creates an evaluator for the given compiled gate.
// The stack is preloaded with constants and ready for evaluation.
func New{{ $ge }}(gate gkrcore.GateBytecode, nbIn int, elementPool ...*{{ $poly }}.Pool{{ $suffix }}) {{ $ge }} {
	e := {{ $ge }}{
		gate: gate,
		nbIn: nbIn,
	}
	if len(elementPool) > 0 {
		e.pool = elementPool[0]
		e.vars = e.pool.Make(gate.EvaluatorSize(nbIn))
	} else {
		e.vars = make([]{{ $elem }}, gate.EvaluatorSize(nbIn))
	}
	e.vars = e.vars[:gate.NbConstants()]
	for i, constVal := range gate.Constants {
		e.vars[i].SetBigInt(constVal)
	}
	{{- if .Mixed }}
	e.consts = make([]{{ .Config.BaseElementType }}, len(gate.Constants))
	for i, constVal := range gate.Constants {
		e.consts[i].SetBigInt(constVal)
	}
	{{- end }}
	return e
}

// Dump returns the evaluator's memory to the pool it was allocated from, if any, and does
// nothing otherwise. The evaluator must not be used after this.
func (e *{{ $ge }}) Dump() {
	if e.pool != nil {
		e.pool.Dump(e.vars)
	}
}

// PushInput adds an input to the evaluator's input buffer.
// Inputs must be added in order, and the number of inputs must match the gate's NbInputs.
func (e *{{ $ge }}) PushInput(input {{ $elem }}) {
	e.vars = append(e.vars, input)
}

// Evaluate adds top to the top of the stack, executes the gate on it and returns the result.
// The stack is automatically reset after evaluation,
// making the evaluator ready for the next evaluation.
// NB! The result is short-lived. It will be overwritten the next time Evaluate is called.
func (e *{{ $ge }}) Evaluate(top ...{{ $elem }}) *{{ $elem }} {
	e.vars = append(e.vars, top...)

	if len(e.vars) != e.nbIn+e.gate.NbConstants() {
		panic(fmt.Sprintf("expected a stack size of %d representing %d constants and %d inputs, got %d", e.nbIn+e.gate.NbConstants(), e.gate.NbConstants(), e.nbIn, len(e.vars)))
	}

	// Execute instructions, appending results to stack
	// The stack grows to: [constants | inputs | results]
	for i := range e.gate.Instructions {
		inst := &e.gate.Instructions[i]
		// Grow len by 1 within the pre-allocated capacity
		e.vars = e.vars[:len(e.vars)+1]
		dst := &e.vars[len(e.vars)-1]

		// Use switch instead of function pointer for better inlining
		switch inst.Op {
		case gkrcore.OpAdd:
			dst.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Add(dst, &e.vars[inst.Inputs[j]])
			}
		case gkrcore.OpMul:
			{{- if .Mixed }}
			// Operands below NbConstants are constants, multiplied by in the base field.
			if a, b := inst.Inputs[0], inst.Inputs[1]; b < e.gate.NbConstants() {
				dst.MulByElement(&e.vars[a], &e.consts[b])
			} else if a < e.gate.NbConstants() {
				dst.MulByElement(&e.vars[b], &e.consts[a])
			} else {
				dst.Mul(&e.vars[a], &e.vars[b])
			}
			for j := 2; j < len(inst.Inputs); j++ {
				if k := inst.Inputs[j]; k < e.gate.NbConstants() {
					dst.MulByElement(dst, &e.consts[k])
				} else {
					dst.Mul(dst, &e.vars[k])
				}
			}
			{{- else }}
			dst.Mul(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Mul(dst, &e.vars[inst.Inputs[j]])
			}
			{{- end }}
		case gkrcore.OpSub:
			dst.Sub(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			for j := 2; j < len(inst.Inputs); j++ {
				dst.Sub(dst, &e.vars[inst.Inputs[j]])
			}
		case gkrcore.OpNeg:
			dst.Neg(&e.vars[inst.Inputs[0]])
		case gkrcore.OpMulAcc:
			var prod {{ $elem }}
			{{- if .Mixed }}
			if b, c := inst.Inputs[1], inst.Inputs[2]; c < e.gate.NbConstants() {
				prod.MulByElement(&e.vars[b], &e.consts[c])
			} else if b < e.gate.NbConstants() {
				prod.MulByElement(&e.vars[c], &e.consts[b])
			} else {
				prod.Mul(&e.vars[b], &e.vars[c])
			}
			{{- else }}
			prod.Mul(&e.vars[inst.Inputs[1]], &e.vars[inst.Inputs[2]])
			{{- end }}
			dst.Add(&e.vars[inst.Inputs[0]], &prod)
		case gkrcore.OpSumExp17:
			// result = (x[0] + x[1] + x[2])^17
			var sum {{ $elem }}
			sum.Add(&e.vars[inst.Inputs[0]], &e.vars[inst.Inputs[1]])
			sum.Add(&sum, &e.vars[inst.Inputs[2]])
			dst.Mul(&sum, &sum) // x²
			dst.Mul(dst, dst)   // x⁴
			dst.Mul(dst, dst)   // x⁸
			dst.Mul(dst, dst)   // x¹⁶
			dst.Mul(dst, &sum)  // x¹⁷
		default:
			panic(fmt.Sprintf("unknown operation: %d", inst.Op))
		}
	}

	res := &e.vars[len(e.vars)-1]

	// Reset for next evaluation
	e.vars = e.vars[:e.gate.NbConstants()]

	return res
}

// {{ $ge }}Pool manages a pool of gate evaluators for a specific gate type.
// All evaluators share the same underlying polynomial.Pool for element slices.
type {{ $ge }}Pool struct {
	gate        gkrcore.GateBytecode
	nbIn        int
	lock        sync.Mutex
	available   []*{{ $ge }}
	elementPool *{{ $poly }}.Pool{{ $suffix }}
}

func New{{ $ge }}Pool(gate gkrcore.GateBytecode, nbIn int, elementPool *{{ $poly }}.Pool{{ $suffix }}) *{{ $ge }}Pool {
	return &{{ $ge }}Pool{
		gate:        gate,
		nbIn:        nbIn,
		elementPool: elementPool,
	}
}

func (gep *{{ $ge }}Pool) Get() *{{ $ge }} {
	gep.lock.Lock()
	if n := len(gep.available); n > 0 {
		e := gep.available[n-1]
		gep.available = gep.available[:n-1]
		gep.lock.Unlock()
		return e
	}
	gep.lock.Unlock()

	e := New{{ $ge }}(gep.gate, gep.nbIn, gep.elementPool)
	return &e
}

func (gep *{{ $ge }}Pool) Put(e *{{ $ge }}) {
	gep.lock.Lock()
	gep.available = append(gep.available, e)
	gep.lock.Unlock()
}

// DumpAll dumps all available evaluators' memory back to the pool. It is not to be used after that.
// NB! User must ensure all evaluators have been put back in the pool to prevent memory leaks.
func (gep *{{ $ge }}Pool) DumpAll() {
	gep.lock.Lock()
	defer gep.lock.Unlock()
	for _, e := range gep.available {
		e.Dump()
	}
	gep.available = nil
}
{{ end }}
