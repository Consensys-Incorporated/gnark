{{- /* G2 point load/store for the g2 ops and MSM pipelines. Dot is the Fp wgslField.
       An Fp2 element is (c0, c1); a point is 3 Fp2 coordinates. */ -}}
{{- $n := .Limbs -}}
{{template "field_io_ab" .}}

fn fp2_load_from(buffer_kind: u32, base: u32) -> Fp2 {
  var z: Fp2;
  z.c0 = {{.Prefix}}_load_from(buffer_kind, base);
  z.c1 = {{.Prefix}}_load_from(buffer_kind, base + {{$n}}u);
  return z;
}

fn g2_load_from(buffer_kind: u32, index: u32) -> G2Point {
  let base = index * {{mul 6 $n}}u;
  var p: G2Point;
  p.x = fp2_load_from(buffer_kind, base + 0u);
  p.y = fp2_load_from(buffer_kind, base + {{mul 2 $n}}u);
  p.z = fp2_load_from(buffer_kind, base + {{mul 4 $n}}u);
  return p;
}

fn fp2_store(base: u32, value: Fp2) {
  {{.Prefix}}_store(base, value.c0);
  {{.Prefix}}_store(base + {{$n}}u, value.c1);
}

fn g2_store(index: u32, value: G2Point) {
  let base = index * {{mul 6 $n}}u;
  fp2_store(base + 0u, value.x);
  fp2_store(base + {{mul 2 $n}}u, value.y);
  fp2_store(base + {{mul 4 $n}}u, value.z);
}
